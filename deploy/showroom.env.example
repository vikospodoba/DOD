SHOWROOM_HOST=dod-showroom.local
SHOWROOM_HTTP_PORT=80
SHOWROOM_HTTPS_PORT=443

DOD_DEFAULT_CHARACTER_ID=default-human
DOD_CHARACTER_IDS=default-human,west,snoop-dogg,trump,kim-jong-un,boris-johnson
DOD_WORKER_TIMEOUT=10s
DOD_WS_ALLOWED_ORIGINS=*

DOD_EXECUTION_PROVIDERS=cuda,cpu
DOD_EXECUTION_THREADS=1
DOD_DISABLE_CUDA_GRAPH=true
DOD_CUDA_GPU_MEM_LIMIT_MB=12288
DOD_POISSON_BLEND=false
DOD_COLOR_CORRECTION=false
DOD_MOUTH_MASK_SIZE=0
DOD_SHARPNESS=0
DOD_OPACITY=1.0
DOD_FACE_ENHANCER=none
DOD_FACE_SWITCH_AREA_RATIO=1.25
DOD_FACE_SWITCH_HOLD_MS=500
DOD_FACE_LOST_HOLD_MS=300
